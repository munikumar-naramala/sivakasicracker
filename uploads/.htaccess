# Uploaded files must never be executable, even if a malicious file slipped
# past Uploader.php's validation. This applies to every uploads/ subfolder.
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|phar)$">
    Require all denied
</FilesMatch>
